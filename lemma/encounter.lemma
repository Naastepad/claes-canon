spec encounter_claim

data canon_status: text
  -> option "PROPOSED"
  -> option "CANON"
  -> option "OPEN"
  -> option "DEPRECATED"
  -> option "REJECTED"

data same_location: boolean
data first_person_present: boolean
data second_person_present: boolean
data first_person_alive: boolean
data second_person_alive: boolean

rule active_canon: false
  unless canon_status is "CANON" then true

rule temporal_presence_valid:
  first_person_present and second_person_present

rule life_boundaries_valid:
  first_person_alive and second_person_alive

rule encounter_possible:
  same_location and temporal_presence_valid and life_boundaries_valid

rule can_meet:
  active_canon and encounter_possible
