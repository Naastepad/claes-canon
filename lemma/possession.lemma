spec possession_claim

data canon_status: text
  -> option "PROPOSED"
  -> option "CANON"
  -> option "OPEN"
  -> option "DEPRECATED"
  -> option "REJECTED"

data possession_earliest: date
data possession_certain_by: date
data query_date: date
data retained_at_query: boolean

rule active_canon: false
  unless canon_status is "CANON" then true

rule possession_window_valid:
  possession_certain_by >= possession_earliest

rule possibly_possessed_by_query:
  query_date >= possession_earliest

rule certainly_possessed_by_query:
  query_date >= possession_certain_by

rule can_possibly_possess:
  active_canon and possession_window_valid and possibly_possessed_by_query and retained_at_query

rule can_possess:
  active_canon and possession_window_valid and certainly_possessed_by_query and retained_at_query
