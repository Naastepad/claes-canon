spec knowledge_claim

data epistemic_status: text
  -> option "FACT"
  -> option "CANON"
  -> option "HYPOTHESIS"
  -> option "DISPUTED"
  -> option "UNKNOWN"

data acquisition_earliest: date
data acquisition_certain_by: date
data query_date: date

rule accepted_as_canon: false
  unless epistemic_status is "FACT" then true
  unless epistemic_status is "CANON" then true

rule allowed_as_hypothesis: false
  unless epistemic_status is "FACT" then true
  unless epistemic_status is "CANON" then true
  unless epistemic_status is "HYPOTHESIS" then true

rule acquisition_window_valid:
  acquisition_certain_by >= acquisition_earliest

rule possibly_acquired_by_query_date:
  query_date >= acquisition_earliest

rule certainly_acquired_by_query_date:
  query_date >= acquisition_certain_by

rule in_acquisition_uncertainty_window:
  acquisition_window_valid and query_date >= acquisition_earliest and query_date < acquisition_certain_by

rule can_know:
  accepted_as_canon and acquisition_window_valid and certainly_acquired_by_query_date

rule can_possibly_know:
  allowed_as_hypothesis and acquisition_window_valid and possibly_acquired_by_query_date
