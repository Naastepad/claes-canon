spec recovery_decode

data canon_status: text
  -> option "PROPOSED"
  -> option "CANON"
  -> option "OPEN"
  -> option "DEPRECATED"
  -> option "REJECTED"

data memoriaal_available: boolean
data vitriol_available: boolean

rule active_canon: false
  unless canon_status is "CANON" then true

rule can_reveal_plaintext:
  active_canon and memoriaal_available and vitriol_available
